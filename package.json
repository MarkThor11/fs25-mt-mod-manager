{
  "name": "fs25-mt-mod-manager",
  "version": "1.3.0",
  "description": "Farming Simulator 25 ModHub Desktop Manager",
  "main": "main-entry.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:renderer && npm run build:main",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist": "npm run build && electron-builder --mac --linux --win",
    "build:main": "node scripts/build-main.js",
    "build:renderer": "vite build"

  "author": {
    "name": "MarkThor11",
    "email": "markwadlow32@gmail.com"

  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.1",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron-builder": "^24.13.3",
    "icon-gen": "^5.0.0",
    "javascript-obfuscator": "^5.9.0",
    "png-to-ico": "^3.0.1",
    "vite": "^5.2.11",
    "vite-plugin-javascript-obfuscator": "^3.1.0",
    "wait-on": "^7.2.0",


  "dependencies": {
    "adm-zip": "^0.5.12",
    "better-sqlite3": "^11.10.0",
    "bytenode": "^2.1.0",
    "cheerio": "^1.0.0-rc.12",
    
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "fast-xml-parser": "^5.7.1",
    "fs-extra": "^11.2.0",
    "lucide-react": "^0.378.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "zustand": "^4.5.2"

  "build": {
    "appId": "com.fs25.modhub-manager",
    "productName": "FS25 MT Mod Manager",
    "artifactName": "FS25-MT-Mod-Manager-Setup-${version}.${ext}",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "MarkThor11",
        "repo": "fs25-mt-mod-manager"
        },
    ],
    "directories": {
      "output": "release"
  
    "files": [
      "dist/**/*",
      "dist-main/**/*",
      "assets/**/*",
      "main-entry.js",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!**/README*",
      "!**/CHANGELOG*",
      "!src/main/**/*",
      "!src/renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
          },
      ],
      "icon": "assets/icon.ico"
  
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
  
    "linux": {
      "target": [
        {
          "target": "AppImage"
      
        {
          "target": "deb"
      
        {
          "target": "rpm"
          },
      ],
      "category": "Utility",
      "icon": "assets/icon.png"
  
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FS25 MT Mod Manager",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "guid": "FS25-MT-MOD-MANAGER-NSIS-GUID",
      "include": "build/installer.nsh"
      },
    },
  },
